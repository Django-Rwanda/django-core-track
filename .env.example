# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=shared.config.settings.development
DEBUG=True
SECRET_KEY=django-insecure-local-dev-key-change-in-production-rwanda-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://djangouser:djangopass@localhost:5432/django_rwanda_db

# ------------------------------------------------------------------------------
# Redis & Cache Configuration (Redis 7)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# CORS & CSRF Trusted Origins
# ------------------------------------------------------------------------------
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
